ANTHROPIC_API_KEY=sk-ant-xxxxx

# GitHub (optional — lets the AI chat file issues when Glen reports something broken)
# Falls back to the `gh` CLI if GITHUB_TOKEN is unset. Use a fine-grained PAT with Issues: write.
GITHUB_TOKEN=
GITHUB_REPO=DanVelarde00/GNM

# Otter MCP (optional — enables auto-pull from Otter.ai)
# Get these from your Otter MCP connector settings
OTTER_MCP_URL=
OTTER_MCP_TOKEN=
OTTER_POLL_INTERVAL=21600   # seconds between background polls (default 6 hours)
GNM_MAX_PER_CYCLE=5         # max transcripts pulled/processed per cycle (throttle)

# Override default paths if needed
# GNM_VAULT_PATH=~/obsidian/GlenVault
# GNM_INBOX_PATH=~/Dropbox/NoteInbox
